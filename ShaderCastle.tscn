title = "Vertex spin"
description = "Applying trigonometric operations to the vertex positions allows spinning the cube."
material = SubResource("ShaderMaterial_lbamv")

[node name="Billboard" parent="Entrance/Vertex shader" unique_id=1712680747 instance=ExtResource("7_xewg6")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -6.1286283, 0, -2.3958015)
title = "Billboard"
description = "Instead of transforming the mesh normally into the camera space, the mesh can be made to always face the camera. This is often used for particle effects.This effect should be used carefully, since it can cause weird effects like grass always looking at you."
material = SubResource("ShaderMaterial_q65ym")

[node name="Vertical billboard" parent="Entrance/Vertex shader" unique_id=1844938133 instance=ExtResource("7_xewg6")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -5.1318555, 0, -2.3958015)
title = "Vertical billboard"
description = "Instead of fully facing the camera, the mesh can be rotated around an axis to face the player. This works for some applications, but also breaks down in others."
material = SubResource("ShaderMaterial_3gpvc")

[node name="Cull back" parent="Entrance/Vertex shader" unique_id=1430775943 instance=ExtResource("7_xewg6")]
transform = Transform3D(-4.371138e-08, 0, 1, 0, 1, 0, -1, 0, -4.371138e-08, -7.5945106, 0, 2.3254852)
title = "Cull Back"
description = "Shaders is about optimization and for closed meshes, the side  of a triangle that is relevant to the user can often be defined, while the other side can be optimized away.Culling means discarding one side of the face, and there are 3 options.Cull Back means not rendering the back faces"
material = SubResource("ShaderMaterial_3m87l")

[node name="Cull front" parent="Entrance/Vertex shader" unique_id=793577331 instance=ExtResource("7_xewg6")]
transform = Transform3D(-4.371138e-08, 0, 1, 0, 1, 0, -1, 0, -4.371138e-08, -7.5945106, 0, 1.2050133)
title = "Cull Front"
description = "Cull Front means not rendering the front face.This shows the inside of the mesh, which can be used to create an outline effect for example."
material = SubResource("ShaderMaterial_kk271")

[node name="Cull off" parent="Entrance/Vertex shader" unique_id=667717992 instance=ExtResource("7_xewg6")]
