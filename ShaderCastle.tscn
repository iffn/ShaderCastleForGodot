[node name="Local vertex offset" parent="Entrance/Vertex shader" unique_id=1185929385 instance=ExtResource("7_xewg6")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -2.313789, 0, -2.3958015)
title = "Local vertex offset"
description = "The vertex shader usually transforms the positions from model to camera space. However, before doing so, the vertex positions chan be modified. Scaling the values results in the scaling of the displayd output mesh."
material = SubResource("ShaderMaterial_bld8a")

[node name="Vertex spin" parent="Entrance/Vertex shader" unique_id=389574024 instance=ExtResource("7_xewg6")]
