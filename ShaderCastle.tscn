[node name="Texture sampling with scaling" parent="Light/Textures and color/TextureSampling" unique_id=1824459064 instance=ExtResource("7_ycgrn")]
transform = Transform3D(-1, 0, -8.742278e-08, 0, 1, 0, 8.742278e-08, 0, -1, 0.62119675, 0, -8)
title = "Texture display with tiling"
description = "When creating a shader, it is often good to think of the overall workflow where the final shader is used. Many people don't know shader programming and creating a separate shader for small adjustments, which doesn't make much sense.A very common use case is the tiling of textures with scale and offset. This can also be shared between different texture types like normal maps."
material = SubResource("ShaderMaterial_52rap")

[node name="Mip maps" parent="Light/Textures and color/TextureSampling" unique_id=1875498350 instance=ExtResource("7_ycgrn")]
transform = Transform3D(-1, 0, -8.742278e-08, 0, 1, 0, 8.742278e-08, 0, -1, 1.806694, 0, -8)
title = "Mip maps"
description = "Just sampling the pixels of textures results in noise, especially when scaling it down. Incorporating surrounding pixels makes it better. These can be precalculated and stored. Therefore, blurry, low resolution versions of the textures are used to make it smoother."
material = SubResource("ShaderMaterial_y60jv")

