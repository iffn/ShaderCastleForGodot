[node name="Painted shadows" parent="StylizedBricks" unique_id=1423633360 instance=ExtResource("4_akt4p")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.9426742, 0, 0)
title = "Painted features"
description = "Hand painting features alows for a large amount of artistic control. This often involves understanding and painting the light. Note that the painted light interactions are set  and do not react to the scene light.
- A dark to bright gradient from the bottom to the top represents that the bottom is usualyl less well lit.
The edges are usually briger, so they are highlighted
- Cracks are painted that follow the structure of the shape.
- The edges of the cracks are highligted. For example, always the bottom and right."
material = SubResource("ShaderMaterial_636rn")
meshToDisplay = SubResource("ArrayMesh_s66ov")
display_scale = 0.18
euler_angles = Vector3(0, 0, 0)

